---
import WpPage from '../components/WpPage.astro';
import { allPages } from '../lib/wp';

export function getStaticPaths() {
  return allPages()
    .filter(({ meta }) => meta.path !== '/404/')
    .map(({ meta, content }) => ({
      params: { slug: meta.path.replace(/^\/|\/$/g, '') || undefined },
      props: { meta, content },
    }));
}

const { meta, content } = Astro.props;
---
<WpPage meta={meta} content={content} />
